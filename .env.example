# Langfuse (get from http://localhost:3000 → Settings → API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# LLM provider
OPENAI_API_KEY=sk-...

# Control plane
CONTROL_PLANE_URL=http://localhost:8500

# Dashboard alert thresholds
ALERT_SCORE_THRESHOLD=0.6
ALERT_ERROR_RATE_THRESHOLD=0.2

# LLM Judge configuration
JUDGE_MODEL=gpt-4o-mini          # model to use for judging
JUDGE_TEMPERATURE=0              # 0 = deterministic
JUDGE_DIMENSIONS=quality,relevance  # comma-separated: quality,relevance,accuracy,safety,conciseness,helpfulness,tone
